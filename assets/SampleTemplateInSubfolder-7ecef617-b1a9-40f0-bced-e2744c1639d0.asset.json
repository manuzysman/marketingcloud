    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Marketing Cloud Test Email</title>\n    <style>\n        body {\n            margin: 0;\n            padding: 0;\n            font-family: Arial, sans-serif;\n            background-color: #f4f4f4;\n        }\n        .email-container {\n            max-width: 600px;\n            margin: 0 auto;\n            background-color: #ffffff;\n        }\n        .header {\n            background-color: #0176d3;\n            padding: 20px;\n            text-align: center;\n        }\n        .header h1 {\n            color: #ffffff;\n            margin: 0;\n            font-size: 24px;\n        }\n        .content {\n            padding: 30px 20px;\n        }\n        .content h2 {\n            color: #333333;\n            font-size: 20px;\n            margin-top: 0;\n        }\n        .content p {\n            color: #666666;\n            line-height: 1.6;\n            font-size: 16px;\n        }\n        .cta-button {\n            display: inline-block;\n            padding: 12px 30px;\n            background-color: #0176d3;\n            color: #ffffff;\n            text-decoration: none;\n            border-radius: 4px;\n            margin: 20px 0;\n        }\n        .footer {\n            background-color: #f4f4f4;\n            padding: 20px;\n            text-align: center;\n            font-size: 12px;\n            color: #999999;\n        }\n        /* Responsive */\n        @media only screen and (max-width: 600px) {\n            .content {\n                padding: 20px 15px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"email-container\">\n        <!-- Header -->\n        <div class=\"header\">\n            <h1>%%Member_Busname%%</h1>\n        </div>\n        \n        <!-- Content -->\n        <div class=\"content\">\n            <h2>Hello %%FirstName%%,</h2>\n            <p>This is a test email template for Marketing Cloud. You can customize this content to match your campaign needs.</p>\n            <p>Personalization examples:</p>\n            <ul>\n                <li>Subscriber Key: %%_subscriberkey%%</li>\n                <li>Email Address: %%emailaddr%%</li>\n                <li>Job ID: %%jobid%%</li>\n                <li>List ID: %%listid%%</li>\n            </ul>\n            \n            <a href=\"%%=RedirectTo(CloudPagesURL(123))=%%\" class=\"cta-button\">Click Here</a>\n            \n            <p>You can test AMPscript, dynamic content, and personalization strings using this template.</p>\n        </div>\n        \n        <!-- Footer -->\n        <div class=\"footer\">\n            <p>%%Member_Busname%%<br>\n            %%Member_Addr%%, %%Member_City%%, %%Member_State%% %%Member_PostalCode%%</p>\n            <p><a href=\"%%profile_center_url%%\" style=\"color: #0176d3;\">Update Profile</a> | \n            <a href=\"%%unsub_center_url%%\" style=\"color: #0176d3;\">Unsubscribe</a></p>\n            <p>&copy; 2025 All rights reserved.</p>\n        </div>\n    </div>\n</body>\n</html>",
